# ============================================
# Klerk API - Configuración de entorno
# Copia este archivo a `.env` y completa los valores.
# ¡NUNCA subas tu `.env` real al repositorio!
# ============================================

# --- Servidor ---
NODE_ENV=development
PORT=2300
BACKEND_URL=http://localhost:2300

# --- CORS (separados por coma) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=klerk
SSL=false

# --- Seguridad ---
# Clave global para el header `x-api-key` (ApiKeyGuard)
API_KEY=change_me_api_key
# Secreto fuerte para firmar JWT (genera uno con: openssl rand -base64 48)
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRATION=24h
SSL_REJECT_UNAUTHORIZED=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REDIRECT_URI=http://localhost:2300/auth/google/callback
GOOGLE_JS_ORIGIN_1=http://localhost:3000

# --- Gemini AI (puedes usar varias claves; se rotan ante 429) ---
GEMINI_API_KEY=change_me
GEMINI_API_KEY_2=change_me

# --- SMTP (verificación de email) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=change_me@gmail.com
MAIL_PASS=change_me