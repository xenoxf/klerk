# ============================================
# Klerk API - Configuración de entorno
# Copia este archivo a `.env` y completa los valores.
# ¡NUNCA subas tu `.env` real al repositorio!
# ============================================

# --- Servidor ---
NODE_ENV=development
PORT=2300
BACKEND_URL=http://localhost:2300

# --- CORS (separados por coma) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=klerk
SSL=false

# --- Seguridad ---
# Clave global para el header `x-api-key` (ApiKeyGuard)
API_KEY=change_me_api_key
# Secreto fuerte para firmar JWT (genera uno con: openssl rand -base64 48)
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRATION=24h
SSL_REJECT_UNAUTHORIZED=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REDIRECT_URI=http://localhost:2300/auth/google/callback
GOOGLE_JS_ORIGIN_1=http://localhost:3000

# --- Gemini AI (proveedor alternativo; varias claves se rotan ante 429) ---
GEMINI_API_KEY=change_me
GEMINI_API_KEY_2=change_me
AI_DEFAULT_GEMINI_MODEL=gemini-2.5-flash-lite

# --- Groq AI (proveedor principal; puedes usar varias claves, se rotan ante 429) ---
# Consigue tu key en https://console.groq.com/keys
GROQ_API_KEY=change_me
GROQ_API_KEY_2=change_me
# Modelos (opcionales; si los omites se usan los valores por defecto)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- IA Config ---
# Proveedor default para IA (auto, groq, gemini)
AI_DEFAULT_PROVIDER=groq
# Siempre modo ahorro por defecto
AI_DEFAULT_MODE=ahorro
# Habilitar fallback automático si el proveedor falla
AI_FALLBACK_ENABLED=true
# Clave de cifrado para BYOK (genera con: openssl rand -base64 32)
APP_ENCRYPTION_KEY=change_me_encryption_key

# --- SMTP (verificación de email) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=change_me@gmail.com
MAIL_PASS=change_me